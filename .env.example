# Origins you want to allow
ALLOWED_ORIGINS=https://site1.com,https://site2.com

# Port (optional, defaults to 4444)
PORT=4444

# Cache configuration
CACHE_MAX_SIZE=200
CACHE_DEFAULT_TTL=300000

# Rate limiting
RATE_LIMIT=100
RATE_WINDOW=60000

# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# Mirror configuration
# Comma-separated list of mirror domains (in priority order)
# Default: anikototv.to,anikoto.cz,anikoto.me,anikoto.net,anikototv.se
MIRROR_DOMAINS=https://anikototv.to,https://anikoto.cz,https://anikoto.me,https://anikoto.net,https://anikototv.se

# Mirror cache TTL in milliseconds (default: 1 hour)
MIRROR_CACHE_TTL=3600000

# Environment (production/development)
NODE_ENV=production

# Domains the M3U8/TS stream proxies may fetch from (comma-separated).
# Subdomains are covered automatically, so list the registrable domain only.
# Leave unset to use the built-in defaults.
# STREAM_PROXY_DOMAINS=megaplay.buzz,vidtube.site,vidplay.site,anipixcdn.co,norami.top,kryntal.top,akirax.buzz

# Referer sent to stream CDNs. They reject the site origin and an empty
# Referer; only the player origin passes. Change if the player domain moves.
# STREAM_PROXY_REFERER=https://megaplay.buzz/

# Admin CMS token — required to use /admin and /api/admin/*. Unset = admin disabled.
# ADMIN_TOKEN=change-me

# ── Subtitle translation ──────────────────────────────────────────────
# Which service translates subtitle tracks. Leave unset to auto-detect:
# DeepL if it has a key, then LibreTranslate if it has a URL, then MyMemory.
# Set it to override that order. One of: deepl | libretranslate | mymemory
# TRANSLATE_PROVIDER=mymemory

# MyMemory needs no account. The anonymous tier works as-is; supplying a
# contact address raises the daily allowance to roughly 50,000 words.
# MYMEMORY_EMAIL=you@example.com

# DeepL — best quality, ~300,000 characters/month on the free tier, which is
# about 27 episodes. Free-tier keys end in ":fx".
# DEEPL_API_KEY=

# LibreTranslate — open source. Use their hosted endpoint, or run your own
# (docker run -p 5000:5000 libretranslate/libretranslate) for no quota at all.
# A self-hosted instance usually needs no key.
# LIBRETRANSLATE_URL=https://libretranslate.com
# LIBRETRANSLATE_API_KEY=
